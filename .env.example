# Copy this file to .env and fill in real values for local development.
# In production, set these as real environment variables on your platform -
# do not deploy a .env file.

DJANGO_SETTINGS_MODULE=website.settings.dev

SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated in production, e.g. example.com,www.example.com
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://example.com

# Matches the "db" service in docker-compose.yml for local dev.
DATABASE_URL=postgres://website:website@db:5432/website

# Don't include /admin or a trailing slash.
WAGTAILADMIN_BASE_URL=http://localhost:8000

# Local dev with docker-compose's mailhog service; use a real smtp:// URL in
# production, e.g. smtp://user:password@smtp.example.com:587
EMAIL_URL=smtp://mailhog:1025
DEFAULT_FROM_EMAIL=webmaster@localhost

# Leave unset to store uploaded media on the local filesystem. Set to enable
# S3-compatible object storage in production (required on most PaaS targets,
# since app containers are ephemeral).
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
