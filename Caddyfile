{
	# Trust X-Forwarded-* headers from anything connecting via the Docker
	# bridge network (Docker's default bridge subnets are in this range).
	# In the reverse-proxy-fronted setup, CloudPanel already sends the
	# correct `X-Forwarded-Proto: https` - but Docker's port-publishing
	# NAT makes that connection appear to Caddy as coming from the bridge
	# gateway IP, not CloudPanel's own address, so without this Caddy
	# doesn't know to trust it and resets X-Forwarded-Proto to "http"
	# (since Caddy's own listener below is plain HTTP). That in turn made
	# Django's `request.is_secure()` always false, breaking HSTS and
	# producing http:// canonical/og:url/JSON-LD URLs even though every
	# real visitor is on https. This is safe: an external client hitting
	# the published port directly still shows up as its own real IP
	# (Docker only rewrites the source for loopback-originated traffic),
	# so it can't spoof its way into this trusted range.
	servers {
		trusted_proxies static 172.16.0.0/12
	}
}

:80 {
	# Plain HTTP, no automatic TLS. This VM sits behind an external reverse
	# proxy (CloudPanel) that terminates TLS and forwards to this VM's
	# port 80 - the VM itself is on a private IP, so it can't receive the
	# Let's Encrypt ACME challenge directly. If you ever point DNS straight
	# at this VM's own public IP instead, switch back to `{$DOMAIN} { ... }`
	# so Caddy issues its own certificate.

	# Security response headers that Django has no equivalent setting for.
	# Strict-Transport-Security is deliberately NOT set here: Django's
	# SecurityMiddleware already sends it (SECURE_HSTS_SECONDS etc. in
	# website/settings/production.py), and now that `trusted_proxies`
	# above makes request.is_secure() correctly return true, that's a
	# single source of truth - adding Caddy's own copy on top produced
	# two different Strict-Transport-Security header values on the same
	# response (each `header` op only replaces headers it explicitly
	# names, it doesn't touch ones the proxied response already carries
	# under a different value). If a reverse proxy in front of Caddy
	# (e.g. CloudPanel) also injects its own default security headers,
	# turn that off in its vhost config instead - otherwise the client
	# still sees two values for the same header (observed in practice:
	# CloudPanel's own X-Frame-Options: SAMEORIGIN alongside Django's
	# X-Frame-Options: DENY).
	header Cross-Origin-Resource-Policy "same-origin"

	# CSP/Permissions-Policy only apply outside /admin/: the Wagtail admin
	# (and its front-end "userbar" overlay shown to logged-in editors on
	# public pages) relies on inline styles/scripts that a strict policy
	# would break, and there's no nonce plumbing in this app to relax that
	# safely just for the admin.
	@notadmin not path /admin/*
	header @notadmin {
		# script-src/img-src/connect-src each carry an extra host for Simple
		# Analytics: scripts.simpleanalyticscdn.com serves the script itself
		# (script-src) *and* needs connect-src too, since browser devtools
		# fetch its latest.js.map source map as a "connect" request, not a
		# script load - CSP doesn't treat that fetch as covered by script-src.
		# queue.simpleanalyticscdn.com is both the noscript <img> beacon
		# (img-src) and the fetch() the script makes to record a pageview
		# (connect-src) - neither falls back to default-src 'self' on its own.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https://queue.simpleanalyticscdn.com; style-src 'self' 'unsafe-inline'; script-src 'self' https://scripts.simpleanalyticscdn.com; font-src 'self'; connect-src 'self' https://queue.simpleanalyticscdn.com https://scripts.simpleanalyticscdn.com; frame-src https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), usb=()"
	}

	# Uploaded images/documents live in the media_data volume, mounted
	# read-only here too (see docker-compose.prod.yml) - Caddy serves
	# these directly rather than proxying to Django. Static files (CSS/JS/
	# fonts) are handled below by WhiteNoise inside the web container, but
	# MEDIA_URL is deliberately not routed by Django's urls.py outside of
	# DEBUG - only the DEBUG dev server is meant to serve media from disk.
	handle_path /media/* {
		root * /srv/media
		file_server
	}

	reverse_proxy web:8000
	encode gzip
}
