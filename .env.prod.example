# Copy to .env.prod on the VM, fill in real values, and keep it out of git
# (already covered by .gitignore's `.env*` pattern - verify before committing).
#
# Usage on the VM:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#   docker compose -f docker-compose.prod.yml --env-file .env.prod exec web python manage.py migrate
#   docker compose -f docker-compose.prod.yml --env-file .env.prod exec web python manage.py createsuperuser

# --- Database (runs as a container on this VM - see the `db` service) -----
POSTGRES_DB=website
POSTGRES_USER=website
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# --- Django / Wagtail -------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
# Your domain(s), comma-separated, no scheme, e.g.: example.com,www.example.com
ALLOWED_HOSTS=example.com
# Same domain(s), but with scheme, e.g.: https://example.com
CSRF_TRUSTED_ORIGINS=https://example.com
# Don't include /admin or a trailing slash.
WAGTAILADMIN_BASE_URL=https://example.com

# --- Email (a real SMTP relay - required in production) --------------------
# e.g. smtp://user:password@smtp.example.com:587
EMAIL_URL=smtp://user:password@smtp.example.com:587
DEFAULT_FROM_EMAIL=webmaster@example.com

# --- Caddy (reverse proxy + automatic HTTPS) --------------------------------
# Must match ALLOWED_HOSTS/WAGTAILADMIN_BASE_URL and point at this VM's
# public IP via DNS before starting, so Caddy can issue a Let's Encrypt cert.
DOMAIN=example.com

# Media (uploaded images/documents) is stored on this VM in a Docker named
# volume (see docker-compose.prod.yml's media_data volume) - there is
# deliberately no AWS_STORAGE_BUCKET_NAME here, since this deployment is
# not using object storage.
